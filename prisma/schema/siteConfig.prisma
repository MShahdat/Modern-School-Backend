model SiteConfig {
  id String @id @default(uuid())

  email        String  @unique
  schoolName   String? @unique
  logo         String?
  logoPublicId String?
  address      String?
  eiin         String? @unique
  estdYear     String?
  isActive     Boolean @default(true)

  facebookUrl  String?
  youtubeUrl   String?
  linkdinUrl   String?
  twitterUrl   String?
  instagramUrl String?

  theme     Json?
  darkTheme Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User[]
  teacher            Teacher[]
  student            Student[]
  staffs             Staff[]
  committees         Committee[]
  events             Event[]
  notice             Notice[]
  news               News[]
  calendar           Calendar[]
  achievement        Achievement[]
  missionVision      MissionVision[]
  routine            Routine[]
  academicRules      AcademicRules[]
  study              Study[]
  apply              Apply[]
  admissionTest      AdmissionTest[]
  registrationSystem RegistrationSystem[]
  activity           Activity[]
  examSchedule       ExamSchedule[]
  uniform            Uniform[]

  @@map("siteConfigs")
}
