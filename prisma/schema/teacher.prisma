model Teacher {
  id String @id @default(uuid())

  teacherId      String              @unique
  name           String
  email          String              @unique
  designation    TeacherDesignation?
  joiningDate    DateTime
  endingDate     DateTime?
  employmentType EmploymentType      @default(FULL_TIME)
  salary         Decimal?            @db.Decimal(10, 2)
  status         UserStatus          @default(ACTIVE)

  department      Group   @default(NONE)
  subject         Json[]
  highestDegree   String? // "M.Sc", "Ph.D"
  specialization  String?
  experienceYears Int?    @default(0)

  fatherName  String?
  motherName  String?
  dateOfBirth DateTime?
  gender      Gender?
  bloodGroup  String?
  religion    String?
  nationality String?   @default("Bangladeshi")
  phone       String?

  presentAddress   Json?
  permanentAddress Json?

  bankName    String?
  bankAccount String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  siteConfigId String
  siteConfig   SiteConfig @relation(fields: [siteConfigId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("teachers")
}
