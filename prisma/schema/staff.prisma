model Staff {
  id String @id @default(uuid())

  staff_id String     @unique
  name     String
  email    String     @unique
  status   UserStatus @default(ACTIVE)

  fatherName String?
  motherName String?
  nationalId String?
  phone      String?
  bio        String?

  designation   StaffDesignation?
  qualification String?
  experience    String?

  startingDate DateTime?
  endingDate   DateTime?

  presentAddress   Json?
  permanemtAddress Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  siteConfigId String
  siteConfig   SiteConfig @relation(fields: [siteConfigId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("staffs")
}
