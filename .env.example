NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://user:password@localhost:5432/modern_school?schema=public

JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

SITE_CONFIG_ID=defaultSiteConfigId
SITE_CONFIG_EMAIL=site@gmail.com

SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@gmail.com
SUPER_ADMIN_PASSWORD=YourStrongPassword123

TESTER_ADMIN_NAME=Tester Admin
TESTER_ADMIN_EMAIL=testeradmin@gmail.com
TESTER_ADMIN_PASSWORD=YourStrongPassword123

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
